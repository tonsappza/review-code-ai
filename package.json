{
  "name": "review-code-ai",
  "version": "1.0.0",
  "description": "AI-powered GitHub Pull Request reviews using the Cursor SDK",
  "type": "module",
  "scripts": {
    "review": "tsx src/review-pr.ts",
    "review:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-review.ps1",
    "ui": "tsx src/local-ui-server.ts",
    "webhook": "tsx src/github-app-server.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@cursor/sdk": "^1.0.17",
    "@octokit/auth-app": "^7.1.4",
    "@octokit/rest": "^21.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
