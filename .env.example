# Cursor API key — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_your_key_here

# For local runs (optional; gh auth or PAT also works)
GITHUB_TOKEN=ghp_your_token_here

# Optional model override
REVIEW_MODEL=composer-2.5

# diff = diff only | explore = read repo checkout + diff (recommended)
REVIEW_MODE=explore

# Reports hub (saved under ./reports by default)
REPORTS_DIR=reports
REPORTS_HUB_REPO=tonsappza/review-code-ai
REPORTS_HUB_BRANCH=master

# Local review — required for npm run review:local
TARGET_REPOSITORY=owner/repo
PR_NUMBER=1

# Optional: use your own checkout (npm run review only — NOT deleted automatically)
# REVIEW_CWD=../other-repo-checkout

# Local UI / hub-review always clone to .review-target and remove after review
# Keep clone folder (debug only)
# KEEP_REVIEW_TARGET=false

# reports/index.json is gitignored — rebuilt locally from pr-*.json files

# PR comment behavior (default: report only, no PR comment)
POST_PR_COMMENT=false
POST_PR_LINK=false
POST_INLINE_COMMENTS=false
INLINE_MIN_SEVERITY=major

# Chunk large PRs (per-file passes when diff > threshold)
CHUNK_DIFF_THRESHOLD=45000
MAX_REVIEW_CHUNKS=12

# Compare with previous report in reports/ (same PR number)
# INCREMENTAL_REVIEW=false

# --- GitHub App webhook (npm run webhook) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
# GITHUB_APP_WEBHOOK_SECRET=
# WEBHOOK_PORT=4040
# GITHUB_APP_POST_PR_LINK=true
# GITHUB_APP_POST_INLINE=false
# HUB_AUTO_COMMIT=false

UI_PORT="4000"